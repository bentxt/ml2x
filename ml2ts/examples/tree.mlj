(* a recursive variant: a binary search tree of integers *)
type btree =
  | Empty
  | Node of int * btree * btree

let rec insert (t : btree) (x : int) : btree =
  match t with
  | Empty -> Node (x, Empty, Empty)
  | Node (v, l, r) ->
      if x < v then Node (v, insert l x, r)
      else if x > v then Node (v, l, insert r x)
      else t

let rec member (t : btree) (x : int) : bool =
  match t with
  | Empty -> false
  | Node (v, l, r) ->
      if x = v then true
      else if x < v then member l x
      else member r x

let rec size (t : btree) : int =
  match t with
  | Empty -> 0
  | Node (_, l, r) -> 1 + size l + size r

let main () : unit =
  let t = Empty in
  let t = insert t 5 in
  let t = insert t 3 in
  let t = insert t 8 in
  let t = insert t 1 in
  let t = insert t 9 in
  print_endline (string_of_bool (member t 8));
  print_endline (string_of_bool (member t 4));
  print_endline (string_of_int (size t))
