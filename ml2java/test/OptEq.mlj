(* Nested-option equality: Some None must stay distinct from None even
   under `=`, and deep nesting must compare structurally (the TS backend
   wraps nested option payloads in a generated _SomeBox, and _eq must
   reach through it; Java boxes the payload too).  Covers `=` and `<>`
   on one, two, and three levels of nesting, plus the boundary cases
   None vs Some None and Some (Some None) vs Some None. *)

let main () : unit =
  print_endline (string_of_bool (Some (Some 1) = Some (Some 1)));
  print_endline (string_of_bool (Some (Some 1) <> Some (Some 1)));
  print_endline (string_of_bool (Some (Some 1) = Some (Some 2)));
  print_endline (string_of_bool (Some None = Some None));
  print_endline (string_of_bool (Some None <> None));
  print_endline (string_of_bool (Some None = None));
  print_endline (string_of_bool (None = None));
  print_endline (string_of_bool (Some (Some None) = Some (Some None)));
  print_endline (string_of_bool (Some (Some None) = Some None));
  print_endline (string_of_bool (Some (Some (Some 1)) = Some (Some (Some 1))));
  print_endline (string_of_bool (Some (Some (Some 1)) = Some (Some (Some 2))))
