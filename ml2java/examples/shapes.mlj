(* NOTE: the record is `pos`, not `point`: a constructor is named `Point`,
   and the checker rejects names that collide case-insensitively in the
   generated file (they would overwrite each other's .class file). *)
type pos = { x : float; y : float }

type shape =
  | Circle of pos * float
  | Rect of pos * pos
  | Point of pos

let rec area (s : shape) : float =
  match s with
  | Circle (_, r) -> 3.14159 *. r *. r
  | Rect (a, b) ->
      let w = if b.x > a.x then b.x -. a.x else a.x -. b.x in
      let h = if b.y > a.y then b.y -. a.y else a.y -. b.y in
      w *. h
  | Point _ -> 0.0

let main () : unit =
  let o = { x = 0.0; y = 0.0 } in
  let c = Circle (o, 1.0) in
  let r = Rect (o, { x = 2.0; y = 3.0 }) in
  print_endline (string_of_float (area c));
  print_endline (string_of_float (area r))
